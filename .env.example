# AMBIENTE DA APLICACAO
# OBRIGATORIA EM PRODUCAO. Sem NODE_ENV=production, o processo usa regras de desenvolvimento.
NODE_ENV=production
# OPCIONAL. Porta HTTP do processo; o padrao e 3000. Valor invalido falha com "PORT deve ser um inteiro entre 1 e 65535."
PORT=3000
# OBRIGATORIA EM PRODUCAO. Se faltar, o boot falha com "WEBSITE_URL e obrigatoria em producao."
WEBSITE_URL=https://comanda.exemplo.invalid

# BANCO DE DADOS
# OBRIGATORIA. Se faltar ou tiver protocolo invalido, o boot falha mencionando DATABASE_URL.
DATABASE_URL=file:./.data/cav-comanda.sqlite
# OBRIGATORIA SOMENTE PARA BANCO REMOTO. Se faltar fora de file:, o boot falha mencionando DATABASE_AUTH_TOKEN.
DATABASE_AUTH_TOKEN=

# ORGANIZACAO E ACESSO INICIAL
# OBRIGATORIA. Se faltar ou for invalida, o boot falha mencionando CAV_ORGANIZACAO_CODIGO.
CAV_ORGANIZACAO_CODIGO=organizacao-exemplo
# OBRIGATORIA. PIN ficticio: substitua antes de operar. Se faltar ou for fraco, o boot falha mencionando CAV_BOOTSTRAP_PIN_GERENCIA.
CAV_BOOTSTRAP_PIN_GERENCIA=4826
# Nao existem PINs de bootstrap por ambiente para garcom, producao ou caixa; crie-os na tela de configuracao.

# REDE E LOCALIZACAO
# OPCIONAL. Lista de origens CORS adicionais separadas por virgula; cada valor invalido falha mencionando CAV_ALLOWED_ORIGINS.
CAV_ALLOWED_ORIGINS=https://painel.exemplo.invalid
# OPCIONAL. Fuso IANA do fechamento diario; o padrao e America/Cuiaba e valor invalido falha mencionando CAV_TIMEZONE.
CAV_TIMEZONE=America/Cuiaba

# BACKUP LOCAL
# OPCIONAL. Diretorio dos backups; o padrao e backups.
CAV_BACKUP_DIR=backups
# OPCIONAL. Quantidade de backups mantidos; o padrao e 30 e valor invalido interrompe o backup.
CAV_BACKUP_RETENTION=30

# BACKUP S3
# OBRIGATORIAS PARA EXECUTAR BACKUP COM ENVIO REMOTO. Se o grupo estiver incompleto, o backup local e preservado e o comando falha mencionando as variaveis ausentes.
S3_ENDPOINT=https://s3.exemplo.invalid
S3_BUCKET=bucket-exemplo-invalido
S3_ACCESS_KEY_ID=CHAVE_FICTICIA_SUBSTITUA
S3_SECRET_ACCESS_KEY=SEGREDO_FICTICIO_SUBSTITUA
# OPCIONAL. Regiao do provedor S3; o padrao e auto.
S3_REGION=auto
# OPCIONAL. Use false somente quando o provedor exigir acesso virtual-hosted; o padrao e true.
S3_FORCE_PATH_STYLE=true

# TEMPLATE DESKTOP E MOBILE
# OPCIONAL PARA WEB. Identificador usado pelos deep links do desktop e pelo hostname de analytics do template.
APPLICATION_ID=aplicacao-exemplo-invalida
# OPCIONAL PARA WEB. Obrigatoria apenas ao executar o pacote mobile sem expo.extra.apiUrl.
EXPO_PUBLIC_API_URL=https://api.exemplo.invalid
